 route endpoint parameters for dependency injection, with support for an optional callable dependency and a `use_cache` boolean flag. Re-exported `Depends` in `fastapi/__init__.py` and added unit test coverage in `tests/test_dependencies.py`.", "commit_message": "feat(dependencies): create Depends container class for dependency injection", "patch": "diff --git a/fastapi/__init__.py b/fastapi/__init__.py\nindex 4554b7c..cb37397 100644\n--- a/fastapi/__init__.py\n+++ b/fastapi/__init__.py\n@@ -1,2 +1,5 @@\n \"\"\"FastAPI framework initialization.\"\"\"\n __version__ = \"0.1.0\"\n+\n+from fastapi.applications import FastAPI\n+from fastapi.params import Depends\ndiff --git a/fastapi/params.py b/fastapi/params.py\nnew file mode 100644\nindex 0000000..f5c8c5c\n--- /dev/null\n+++ b/fastapi/params.py\n@@ -0,0 +1,12 @@\n+from typing import Any, Callable, Optional\n+\n+\n+class Depends:\n+    def __init__(\n+        self, dependency: Optional[Callable[..., Any]] = None, *, use_cache: bool = True\n+    ):\n+        self.dependency = dependency\n+        self.use_cache = use_cache\n+\n+    def __repr__(self) -> str:\n+        attr = getattr(self.dependency, \"__name__\", type(self.dependency).__name__)\n+        return f\"{self.__class__.__name__}({attr})\"\ndiff --git a/tests/test_dependencies.py b/tests/test_dependencies.py\nnew file mode 100644\nindex 0000000..637c385\n--- /dev/null\n+++ b/tests/test_dependencies.py\n@@ -0,0 +1,15 @@\n+from fastapi.params import Depends\n+\n+\n+def test_depends():\n+    def get_db():\n+        return \"db\"\n+\n+    dep = Depends(get_db)\n+    assert dep.dependency == get_db\n+    assert dep.use_cache is True\n+\n+    dep_no_cache = Depends(get_db, use_cache=False)\n+    assert dep_no_cache.use_cache is False\n+\n+    dep_none = Depends()\n+    assert dep_none.dependency is None\n"}, "returned_files": ["fastapi/__init__.py", "fastapi/params.py", "tests/test_dependencies.py"], "timestamp": "2026-09-02T13:40:20.935496+00:00", "step_tokens": {"